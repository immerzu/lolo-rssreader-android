# Beispiel fuer keystore.properties (wird NICHT committet, ist in .gitignore).
#
# Die Passwoerter liegen benutzergebunden in der Windows-Anmeldeinformations-
# verwaltung (Credential Manager) und werden zur Buildzeit ueber
# tools/get-signing-secret.ps1 abgerufen – hier stehen KEINE Klartext-Passwoerter.
# Zielnamen (Targets) in der Anmeldeinformationsverwaltung:
#   rssreader_store_password
#   rssreader_key_password
# Einmaliges Befuellen dieser Eintraege: tools/migrate-signing-secrets.ps1
# (liest eine bestehende Klartext-keystore.properties und uebertaegt die Werte)
#
# Nicht-geheime Angaben:
storeFile=signing/rss-reader-release.jks
keyAlias=rssreader
